# Скопируйте в .env. Имена переменных — как в reference-проекте курса (otus-practice-yc-gpt-aug).
# Без ключа всё работает в режиме replay: ответы модели берутся из outputs/llm_cache.

# Секрет API-ключа сервисного аккаунта с ролью ai.languageModels.user
YC_API_KEY=
# Идентификатор API-ключа (для справки, в запросах не нужен)
YC_API_KEY_ID=
# Каталог Yandex Cloud (b1g...)
YC_FOLDER_ID=

# live — запросы к API (ответы пишутся в кэш), replay — только кэш
# LLM_MODE=live
# YC_MODEL=yandexgpt-lite/latest
# TEMPERATURE=0.1
# TOP_K=5
